# Laravel API base URL
VITE_API_URL=http://localhost:8000
VITE_API_PREFIX=/api/v1

# Laravel Reverb (WebSocket) — local or self-hosted
VITE_REVERB_APP_KEY=local-key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Realtime kill-switch — set to false when no Reverb/Pusher server is running.
# Start Reverb with: php artisan reverb:start --host=127.0.0.1 --port=8080
VITE_REALTIME_ENABLED=true

# Pusher Channels (Free Cloud alternative to Reverb)
# VITE_PUSHER_APP_KEY=your_pusher_key
# VITE_PUSHER_APP_CLUSTER=mt1
