APP_NAME="Garage Parts Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

# Frontend & Admin URLs (CORS + Sanctum stateful + password reset links)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- Database: MySQL 8 ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=garage_parts
DB_USERNAME=root
DB_PASSWORD=secret

# --- Auth: Laravel Sanctum (stateless Bearer API — no CSRF) ---
SANCTUM_STATEFUL_DOMAINS=
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# --- OAuth (Laravel Socialite): Google, Facebook, GitHub ---
# Callback defaults to {APP_URL}/api/v1/auth/oauth/{provider}/callback.
# Google Console → Authorized redirect URI must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/oauth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/v1/auth/oauth/facebook/callback"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/api/v1/auth/oauth/github/callback"

# --- Broadcasting / WebSocket: Laravel Reverb ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=1001
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Cache: file by default, redis when required ---
CACHE_STORE=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# --- Queue: database by default, redis-ready ---
QUEUE_CONNECTION=database

# --- Filesystem / Storage (Options: 'public' for Local Machine, 'efs' for AWS EFS, 's3' for AWS S3) ---
# Default: 'public' (local machine storage in storage/app/public)
FILESYSTEM_DISK=public

# --- AWS Elastic File System (EFS) Configuration (Active when FILESYSTEM_DISK=efs) ---
AWS_EFS_NAME=gap-marketplace
AWS_EFS_FILESYSTEM_ID=fs-09f27049f75b949db
AWS_EFS_ARN=arn:aws:elasticfilesystem:ap-southeast-2:285150348650:file-system/fs-09f27049f75b949db
AWS_EFS_ACCESS_POINT_ARN=arn:aws:elasticfilesystem:ap-southeast-2:285150348650:access-point/fsap-042f0d387ab010679
AWS_EFS_DNS=fs-09f27049f75b949db.efs.ap-southeast-2.amazonaws.com
AWS_EFS_REGION=ap-southeast-2
# Set mount path if EFS is mounted to a specific directory (e.g., /mnt/efs or /var/www/html/storage/app/public)
AWS_EFS_MOUNT_PATH=
AWS_EFS_URL="${APP_URL}/storage"

# --- AWS S3 / S3-Compatible Cloud Storage (Active when FILESYSTEM_DISK=s3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail (log locally until SMTP is configured) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=debug
