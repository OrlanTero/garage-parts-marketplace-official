# ==============================================================================
# Garage Parts Marketplace — Production Cloud Environment Variables Template
# Deployable to Render.com (Free Web Service), Koyeb (Free Eco), or Railway
# ==============================================================================

# Core Application Settings
APP_NAME="Garage Parts Marketplace"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://garage-parts-api.onrender.com

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS) & Allowed Clients
FRONTEND_URL=https://garage-parts.vercel.app
ADMIN_URL=https://garage-parts-admin.vercel.app
CORS_ALLOWED_ORIGINS=https://garage-parts.vercel.app,https://garage-parts-admin.vercel.app

# Database: TiDB Cloud Serverless (MySQL 8.0 Compatible, 25 GB Free)
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=garage_parts
DB_USERNAME=your_tidb_user.root
DB_PASSWORD=your_tidb_password
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# Session, Cache & Queue Drivers
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database

# --- Storage / Filesystem (Options: 'public' for Local, 'efs' for AWS EFS, 's3' for Cloudflare R2 / AWS S3) ---
# Default: 'public' (local machine/container storage in storage/app/public)
FILESYSTEM_DISK=public

# AWS Elastic File System (EFS) Settings (used when FILESYSTEM_DISK=efs)
AWS_EFS_NAME=gap-marketplace
AWS_EFS_FILESYSTEM_ID=fs-09f27049f75b949db
AWS_EFS_ARN=arn:aws:elasticfilesystem:ap-southeast-2:285150348650:file-system/fs-09f27049f75b949db
AWS_EFS_ACCESS_POINT_ARN=arn:aws:elasticfilesystem:ap-southeast-2:285150348650:access-point/fsap-042f0d387ab010679
AWS_EFS_DNS=fs-09f27049f75b949db.efs.ap-southeast-2.amazonaws.com
AWS_EFS_REGION=ap-southeast-2
AWS_EFS_MOUNT_PATH=/mnt/efs
AWS_EFS_URL="${APP_URL}/storage"

# Media Storage: Cloudflare R2 (10 GB Free, S3 Compatible, $0 Egress) or AWS S3 (used when FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=garage-parts-media
AWS_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=https://pub-your_r2_subdomain.r2.dev

# Real-Time WebSockets: Pusher Channels (Free Sandbox: 200,000 msgs/day)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=your_pusher_app_id
PUSHER_APP_KEY=your_pusher_app_key
PUSHER_APP_SECRET=your_pusher_app_secret
PUSHER_APP_CLUSTER=ap1

# Container Startup Automation (Set to true on initial deploy, then false)
AUTO_MIGRATE=true
AUTO_SEED=false
